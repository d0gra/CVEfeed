# Port Hostinger / your host assigns. Leave unset to default to 3000.
PORT=3000

# Comma-separated list of enabled sources.
# Available: nvd, kev, github, euvd, cisa
SOURCES=nvd,kev,github,euvd,cisa

# How long a fetched feed is reused before being refetched, in minutes.
CACHE_TTL_MINUTES=20

# Background refresh interval in minutes. Set to 0 to only fetch on request.
REFRESH_INTERVAL_MINUTES=20

# How far past the TTL an old snapshot may still be served instantly while the
# refresh runs in the background. This is what spares the first visitor after an
# idle period the full ~25s upstream round trip. Beyond TTL + this window the
# request blocks and waits for fresh data instead. 0 disables it.
STALE_WHILE_REVALIDATE_MINUTES=360

# How many days back to pull from NVD (1-120).
NVD_DAYS=7

# Optional NVD API key - raises the rate limit from 5 to 50 requests / 30s.
# Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional GitHub token - raises the advisories rate limit to 5000/hour.
GITHUB_TOKEN=

# Keep a JSON snapshot on disk so restarts are instant and the dashboard
# survives an upstream outage. This is a plain file, not a database.
DISK_CACHE=true
DISK_CACHE_DIR=.cache

# Public origin, used for canonical URLs, sitemap entries and Open Graph tags.
# Leave unset in development; set it in production, especially behind a proxy
# that terminates TLS, where the request's own scheme is http.
SITE_URL=https://yourdomain.com

# Optional shared secret for POST /api/refresh. Unset = endpoint disabled.
REFRESH_TOKEN=

# NVD pages to pull (500 CVEs each). More pages = deeper feed, slower refresh.
NVD_MAX_PAGES=2

# Drop CISA KEV entries older than this many days unless another source also
# reports them. 0 keeps the entire historical catalog.
KEV_DAYS=90
