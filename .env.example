# Port Hostinger / your host assigns. Leave unset to default to 3000.
PORT=3000

# --- process and thread footprint ---
# Shared hosting counts threads against a process cap, and a default Node
# process on a many-core machine starts around a dozen: one main, four for
# libuv's pool, and one V8 platform worker per core up to a limit. Neither
# pool does real work here - this app waits on network rather than computing -
# so both are pinned small. Together these take a process from roughly twelve
# threads to eight. Raise them if you ever make this CPU-bound.
UV_THREADPOOL_SIZE=2
NODE_OPTIONS=--v8-pool-size=2

# Comma-separated list of enabled sources.
# Available: nvd, kev, github, euvd, cisa
SOURCES=nvd,kev,github,euvd,cisa

# How long a fetched feed is reused before being refetched, in minutes.
CACHE_TTL_MINUTES=20

# In-process refresh timer, in minutes. Only honoured when WEB_REFRESH=true;
# a read-only worker never refreshes, whatever this says.
REFRESH_INTERVAL_MINUTES=0

# How far past the TTL an old snapshot may still be served instantly while the
# refresh runs in the background. This is what spares the first visitor after an
# idle period the full ~25s upstream round trip. Beyond TTL + this window the
# request blocks and waits for fresh data instead. 0 disables it.
STALE_WHILE_REVALIDATE_MINUTES=360

# Whether web workers may refresh the data themselves. Leave this off when a
# database is configured: a refresh peaks around 475 MB and V8 keeps the heap
# afterwards, so a worker that refreshes once stays that size. With it off,
# workers only read and scripts/refresh.js, run from cron, owns refreshing -
# see "Web workers only read; cron refreshes" in the README. Turn it on only
# where no cron is available.
WEB_REFRESH=false

# How old the last refresh may get before /healthz reports the feed stale -
# the signal that the cron job has stopped. Two missed 30-minute runs.
STALE_AFTER_MINUTES=60

# How many days back to pull from NVD (1-120).
NVD_DAYS=7

# Optional NVD API key - raises the rate limit from 5 to 50 requests / 30s.
# Free: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional GitHub token - raises the advisories rate limit to 5000/hour, and
# is what makes the public-PoC signal reliable on shared hosting, where the
# unauthenticated limit of 60/hour is shared with every other site on the IP.
GITHUB_TOKEN=

# Exploit-availability signals, comma separated. Each is independent: one
# being unreachable removes that signal and nothing else.
# Available: exploitdb, metasploit, nuclei, poc, vulncheck
EXPLOIT_SOURCES=exploitdb,metasploit,nuclei,poc,vulncheck

# How long exploit signals are reused. They change slowly and the downloads
# are large (~27MB in total), so this is deliberately much longer than the
# feed's own cache.
EXPLOIT_TTL_HOURS=12

# How long the first feed build may wait for exploit signals before serving
# without them. They attach on the next refresh either way.
EXPLOIT_BUDGET_SECONDS=25

# Optional VulnCheck Community token. Their KEV catalog is considerably larger
# than CISA's; without a token that signal is simply absent.
# Free registration: https://vulncheck.com
VULNCHECK_TOKEN=

# Keep a JSON snapshot on disk so restarts are instant and the dashboard
# survives an upstream outage. This is a plain file, not a database.
DISK_CACHE=true
DISK_CACHE_DIR=.cache

# How many per-CVE cache entries to keep, in memory and on disk. One is
# created per CVE anyone looks up, and /cve/:id answers for every published
# CVE, so without a cap a crawler walking the site grows the cache until the
# process runs out of memory. The oldest are dropped first; dropping one only
# costs a refetch.
CACHE_MAX_ENTRIES=500

# Public origin, used for canonical URLs, sitemap entries and Open Graph tags.
# Leave unset in development; set it in production, especially behind a proxy
# that terminates TLS, where the request's own scheme is http.
SITE_URL=https://yourdomain.com

# MongoDB, optional. When set, the exploit-signal index lives in the database
# instead of in the process, which is most of this app's memory and disk
# footprint. Unset, everything stays in memory exactly as before.
# Never commit a real connection string - put it in .env, which is gitignored.
MONGODB_URI=
MONGODB_DB=cvefeed

# Connection pool size, per replica-set member. The driver defaults to 100
# sockets, which is a lot for an app that makes a few queries per request -
# and note this is multiplied by the three members of an Atlas replica set,
# plus one monitoring connection each. 3 is ample for this traffic.
MONGODB_POOL_SIZE=3
MONGODB_TIMEOUT_SECONDS=10

# --- dependency sweeps ---
# The one request that can fan out to hundreds of upstream lookups. Both caps
# bound that fan-out; the rate limit is per IP per hour, loose enough for a CI
# job checking its lockfile on every commit.
DEPS_MAX_PACKAGES=600
DEPS_MAX_ADVISORIES=250
DEPS_RATE_MAX=60
# Largest manifest accepted, in kilobytes. A real package-lock.json is big.
DEPS_MAX_MANIFEST_KB=1024

# --- rate limiting (per client IP, per window; 0 disables a given limiter) ---
RATE_WINDOW_SECONDS=60
# Max requests per window for the JSON API, the MCP endpoint, and the pages.
API_RATE_MAX=120
MCP_RATE_MAX=60
PAGE_RATE_MAX=240
# The shared budget for the upstream lookup fan-out (an uncached CVE lookup
# spends one request against GitHub's 60/hour anonymous, per-IP limit). A burst
# of this many, then a steady refill per second. Protects the whole host's
# GitHub budget from a spray of distinct CVE ids.
LOOKUP_BURST=15
LOOKUP_REFILL_PER_SEC=0.2

# --- community proof-of-concept submissions ---
# Submissions are held for review and never shown until approved. Auto-approve
# is for a trusted private instance only; leave it false in public.
POC_AUTO_APPROVE=false
# Secret for the moderation endpoints (approve/reject, pending queue). Falls
# back to REFRESH_TOKEN if unset; unset entirely disables those endpoints.
POC_MODERATION_TOKEN=
# Max submissions accepted per IP per hour, and the largest PoC body.
POC_SUBMIT_MAX=5
POC_MAX_CHARS=20000

# CAPTCHA. With a Cloudflare Turnstile key pair the widget is used and verified
# server-side (recommended, privacy-respecting). Without it, a built-in signed
# arithmetic challenge is the gate. CAPTCHA_SECRET keeps that challenge valid
# across restarts; a random value is used when unset.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
CAPTCHA_SECRET=

# Optional shared secret for POST /api/refresh. Unset = endpoint disabled.
REFRESH_TOKEN=

# NVD pages to pull (500 CVEs each). More pages = deeper feed, slower refresh.
NVD_MAX_PAGES=2

# Drop CISA KEV entries older than this many days unless another source also
# reports them. 0 keeps the entire historical catalog.
KEV_DAYS=90
