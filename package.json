{
  "name": "cvefeed",
  "version": "1.0.0",
  "description": "Live CVE / vulnerability dashboard aggregating trusted public feeds. No database required.",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "warm": "node scripts/warm-cache.js",
    "test:mcp": "node test/mcp-conformance.mjs",
    "test:exploits": "node test/exploit-resilience.mjs",
    "test": "node test/terms.mjs && node test/health.mjs && node test/budget.mjs && node test/suggest.mjs && node test/cache-bounds.mjs && node test/ratelimit.mjs && node test/poc.mjs && node test/exploit-resilience.mjs && node test/store.mjs && node test/deps.mjs && node test/mcp-conformance.mjs",
    "test:cache": "node test/cache-bounds.mjs",
    "refresh": "node scripts/refresh.js",
    "refresh:all": "node scripts/refresh.js --exploits",
    "test:store": "node test/store.mjs",
    "test:ratelimit": "node test/ratelimit.mjs",
    "test:poc": "node test/poc.mjs",
    "test:deps": "node test/deps.mjs",
    "test:terms": "node test/terms.mjs",
    "test:suggest": "node test/suggest.mjs",
    "test:health": "node test/health.mjs",
    "test:budget": "node test/budget.mjs"
  },
  "keywords": [
    "cve",
    "vulnerability",
    "nvd",
    "cisa",
    "kev",
    "security",
    "dashboard",
    "mcp",
    "model-context-protocol",
    "ai-security",
    "agentic"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "dependencies": {
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
