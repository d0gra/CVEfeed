node_modules/

# Every .env variant, because the one that gets committed is always the one
# nobody thought to add. The example is the deliberate exception.
.env
.env.*
!.env.example
# Any file ending in .env, wherever it is. `.env.*` does not catch a name like
# cvefeed.env, which is exactly the shape a server-side env file takes when it
# is drafted locally first.
*.env

.cache/
npm-debug.log*
.DS_Store
*.log
.claude/
